# Build environment for the UMP rescue image; see build.sh and the
# Makefile's rescue-image target (the container must run privileged, since
# mmdebstrap mounts /proc and /sys into the chroot).
FROM debian:trixie
RUN apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
	mmdebstrap cpio zstd ca-certificates qemu-user-static binfmt-support arch-test \
	build-essential zlib1g-dev liblzma-dev xz-utils curl \
	&& rm -rf /var/lib/apt/lists/*
WORKDIR /work
ENTRYPOINT ["./build.sh"]
