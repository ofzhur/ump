# /etc/fstab, written by UMP (keep-data: the root made anew, the old system's other volumes as they were)
UUID=NEW-sys-root  /  ext4  defaults,errors=remount-ro  0 1
UUID=3E86-EC85  /boot/efi  vfat  umask=0077  0 1
/dev/mapper/sys-var  /var.old  xfs  defaults  0 2
/dev/mapper/sys-docker  /var/lib/docker  xfs  defaults,pquota  0 2
/dev/mapper/sys-home  /home  ext4  defaults,usrquota  0 2
/dev/mapper/sys-thin  /srv/thin  ext4  defaults  0 2
LABEL=scratch  /scratch  ext4  defaults,nofail  0 2
nas.example.net:/export/media  /srv/media  nfs4  ro,_netdev  0 0
//files.example.net/share  /srv/share  cifs  credentials=/root/.smb,password=hunter2,uid=1000  0 0
/var/lib/docker/volumes  /srv/volumes  none  bind  0 0
/opt/old/app  /srv/app  none  bind  0 0
/srv/My\040Files  /mnt/my\040files  none  bind  0 0
tmpfs  /run/shm  tmpfs  defaults  0 0
