==> /etc/rc.conf
# /etc/rc.conf, written by UMP at installation (profile freebsd-15.1); sysrc
# changes it, /etc/defaults/rc.conf has what is not set here.
hostname="web-01.example.net"
zfs_enable="YES"
sshd_enable="YES"
ntpd_enable="YES"
ntpd_sync_on_start="YES"
sendmail_enable="NONE"
syslogd_flags="-ss"
# the firewall: /etc/pf.conf
pf_enable="YES"
pflog_enable="YES"
# the interfaces by MAC address (/usr/local/etc/rc.d/ump_ifnames renames
# them before the network starts): ext01, ... the uplink and those with a
# public address, int01, ... the rest
ump_ifnames_enable="YES"
ump_ifnames="ext01=0c:c4:7a:aa:bb:10 int01=0c:c4:7a:aa:bb:11"
ifconfig_int01="up"
ifconfig_ext01="DHCP"
==> /etc/resolv.conf
==> /etc/resolvconf.conf
==> /etc/ump/install (the network)
network=dhcp
network6=none
dns=dhcp
==> the plan
ext01 (0c:c4:7a:aa:bb:10) IPv4 dhcp (client ID: MAC), IPv6 none (the specification's uplink); IPv6 off; DNS from DHCP
