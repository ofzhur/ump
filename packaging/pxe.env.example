# /etc/ump/pxe/SITE.env: the settings of ump-pxe@SITE and its check,
# ump-pxe-check@SITE; systemd reads it, so it is root's alone:
#   install -m 0600 /usr/share/ump/pxe.env.example /etc/ump/pxe/fra1.env
# See https://github.com/ofzhur/ump/blob/main/docs/pxe.md

# The backend of the home, where ump config pxe apply renders the site:
# S3, R2, HTTP, Consul or Vault, reached over the network (a file:// or
# ssh:// backend is for ump pxe serve by hand, docs/pxe.md).
UMP_STATE=r2://0123456789abcdef0123456789abcdef/fleet-state/ump
# Its secrets (S3, R2: these; HTTP, Consul, Vault: UMP_STATE_TOKEN or
# UMP_STATE_USER and UMP_STATE_PASSWORD), here or as systemd credentials
# of the same names.
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# The flags of ump pxe serve, as UMP_PXE_ and the flag's name in upper
# case; the site is the instance's name. On a host with public addresses,
# give the private network's.
UMP_PXE_HTTP=192.0.2.5:8067
#UMP_PXE_TFTP=192.0.2.5:69
#UMP_PXE_IPXE_DIR=/usr/lib/ipxe
#UMP_PXE_URL=http://192.0.2.5:8067
#UMP_PXE_POLL=10s
